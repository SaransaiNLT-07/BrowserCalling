# Production environment. Copy to backend/.env.production (git-ignored) and fill in.
# Used by docker-compose.prod.yml for the api, postgres and caddy services.

# Public domain: its DNS record must point at this server, with ports 80 and 443 open.
DOMAIN=call.example.com

# Django
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=call.example.com
CSRF_TRUSTED_ORIGINS=https://call.example.com
# Browser origins allowed to call the API and open the WebSocket (web app, Expo web).
CORS_ALLOWED_ORIGINS=https://call.example.com
CORS_ALLOW_ALL_ORIGINS=false
UVICORN_WORKERS=2

# Postgres (read by both the postgres container and Django)
POSTGRES_DB=saran
POSTGRES_USER=saran
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Auth and calls
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PRESENCE_TTL_SECONDS=90
CALL_RING_TIMEOUT_SECONDS=45
CALL_OFFLINE_GRACE_SECONDS=20

# Cloudflare Realtime TURN (server-side only; never put these in frontend or mobile env)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=86400
STUN_URLS=stun:stun.cloudflare.com:3478
