# Same Django API the mobile client uses.
# In Docker, leave these as /api and empty WS so the browser stays same-origin.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/signaling/
VITE_STUN_URLS=stun:stun.l.google.com:19302
# TURN credentials come from the backend (GET /api/calls/ice-servers/, Cloudflare).
# The values below are only a fallback if that request fails.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
