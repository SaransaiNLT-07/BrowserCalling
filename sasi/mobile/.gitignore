# =============================================================================
# mobile/ (Expo SDK + Expo Router + react-native-webrtc)
# This folder is its own git repo, so this file covers everything it needs.
# =============================================================================

# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects. Generated by `npx expo prebuild` (Continuous Native Generation).
# Delete these two lines if you ever start hand-editing native code.
/ios/
/android/

# Native build output
.kotlin/
.gradle/
local.properties
*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM/
DerivedData/
xcuserdata/
Pods/
*.hprof
*.orig.*

# Signing material: never commit (use EAS credentials)
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Environment: EXPO_PUBLIC_* values are inlined into the app bundle.
# Commit only .env.example, and never put secrets in it.
.env
.env.*
!.env.example

# Metro
.metro-health-check*

# TypeScript / lint / tests
*.tsbuildinfo
.eslintcache
coverage/

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Editors: share team VS Code settings only
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# OS
.DS_Store
Thumbs.db
